# Salin file ini menjadi .env (jangan di-commit).
PORT=5000

# MySQL (XAMPP lokal: host 127.0.0.1, user root, password kosong)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=db_opentools

# Kunci admin untuk halaman /admin/qr dan hapus campaign oleh admin. WAJIB diisi dengan string acak panjang.
ADMIN_KEY=
# Login admin di /admin/qr: username dan hash password (buat hash dengan: node scripts/hash-admin-password.mjs)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Tujuan transfer manual paket QR Generator
PAY_DANA_NUMBER=082181361433
PAY_DANA_NAME=
PAY_WHATSAPP=6282181361433

# Data perusahaan pada nota pesanan (kosongkan untuk memakai nilai contoh)
NOTA_COMPANY_NAME=
NOTA_ADDRESS=
NOTA_CONTACT=
NOTA_CITY=
NOTA_SIGNER_NAME=
NOTA_SIGNER_TITLE=
NOTA_NPWP=

# Analisa bukti transfer otomatis (Claude). Kosong = semua bukti masuk pemeriksaan admin manual.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
