# Templat .htaccess untuk folder situs di cPanel (opentools.garudanexa.com).
# File ini TIDAK ikut deploy otomatis. Salin manual sebagai ".htaccess" hanya saat menyiapkan server baru.
# Alasannya: cPanel (Setup Node.js App) menambahkan blok Passenger dan variabel lingkungan ke .htaccess
# di server. Kalau deploy menimpa file itu, sambungan ke aplikasi Node hilang dan semua /api jadi 404.
<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /
  # Folder backend (kode server dan .env) dan repo git tidak boleh diakses dari web
  RewriteRule ^(backend|node_modules|\.git)(/|$) - [F,L]
  RewriteRule ^index\.html$ - [L]
  # API ditangani server Node, jangan dialihkan ke index.html
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
